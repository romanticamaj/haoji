# 好記 Haoji deployable unit — copy to .env and adjust.  Full reference: README.md → Configuration.

# --- notes model ---------------------------------------------------------------------------------
LLM_MODEL=gemma4:e4b-it-qat
# LLM_PROVIDER=openai            # use an OpenAI-compatible API instead of the ollama container
# OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
# OPENAI_API_KEY=

# --- network & access ----------------------------------------------------------------------------
WEB_PORT=7780
# URLs your phone can reach this box at (Tailscale / LAN / tailscale serve). First one goes in the
# pairing QR code. Names listed here are also allowed as Host headers (DNS-rebinding guard).
HAOJI_PUBLIC_URLS=
# Extra hostnames to accept (comma-separated) — IP addresses and localhost are always accepted.
HAOJI_ALLOWED_HOSTS=
# Console admin token. Blank = generated on first boot into the data volume:
#   docker compose exec haoji-backend cat /data/admin_token
HAOJI_ADMIN_TOKEN=
# 1 = phones must present the pairing token (scan the QR in the console). Recommended once paired.
HAOJI_REQUIRE_TOKEN=0
# Hours the server keeps a finished transcript/notes for the phone to collect (0 = until collected).
HAOJI_RETENTION_HOURS=24

# --- push notifications (iOS, optional) ---------------------------------------------------------
# Put the APNs .p8 at deploy/secrets/apns.p8 (never commit it). Blank APNS_KEY_ID = no push.
APNS_KEY_ID=
APNS_TEAM_ID=

# --- only when BUILDING the breeze-asr image (pyannote is gated on Hugging Face) ------------------
HF_TOKEN=
