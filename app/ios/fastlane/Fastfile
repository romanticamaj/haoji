default_platform(:ios)

platform :ios do
  desc "Build a Release archive and upload it to TestFlight"
  lane :beta do
    key = app_store_connect_api_key(
      key_id: "S4KA24P9A5",
      issuer_id: "efcfbd71-5d12-4d85-8efc-5cee020286d9",
      key_filepath: File.expand_path("~/.private_keys/AuthKey_S4KA24P9A5.p8"),
    )

    # Next build number = latest on TestFlight + 1
    latest = latest_testflight_build_number(
      api_key: key,
      app_identifier: "com.garyhsieh.haoji",
      initial_build_number: 0,
    )
    increment_build_number(build_number: latest.to_i + 1, xcodeproj: "Haoji.xcodeproj")

    # development: false -> Apple *Distribution* cert (needs Admin/Developer role on the ASC key)
    cert(api_key: key, development: false, output_path: "./certs")

    profile_name = "Haoji AppStore"
    get_provisioning_profile(
      api_key: key,
      app_identifier: "com.garyhsieh.haoji",
      provisioning_name: profile_name,
      force: true,
    )

    build_app(
      workspace: "Haoji.xcworkspace",
      scheme: "Haoji",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { "com.garyhsieh.haoji" => profile_name },
      },
    )

    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end
end

platform :ios do
  desc "One-time: create the App Store Connect app record via the stored Apple ID session"
  lane :bootstrap do
    produce(
      username: "romanticamaj@gmail.com",
      app_identifier: "com.garyhsieh.haoji",
      app_name: "好記",
      language: "Traditional Chinese",
      sku: "haoji-garyhsieh-2026",
      company_name: "Gary Hsieh",
      team_id: "64N77Z6TV3",
      skip_devcenter: true,
    )
  end
end

platform :ios do
  desc "Ensure an internal TestFlight group exists and add an internal tester (email via ENV TESTER_EMAIL)"
  lane :add_tester do
    app_store_connect_api_key(
      key_id: "S4KA24P9A5",
      issuer_id: "efcfbd71-5d12-4d85-8efc-5cee020286d9",
      key_filepath: File.expand_path("~/.private_keys/AuthKey_S4KA24P9A5.p8"),
    )
    email = ENV["TESTER_EMAIL"] || "romanticamaj@gmail.com"
    app = Spaceship::ConnectAPI::App.find("com.garyhsieh.haoji")
    group = app.get_beta_groups.find(&:is_internal_group)
    if group.nil?
      # create_beta_group always sends publicLink* attrs, which Apple rejects for internal
      # groups — POST a clean internal-group body instead.
      body = { data: { attributes: { name: "Internal", isInternalGroup: true, hasAccessToAllBuilds: true },
                       relationships: { app: { data: { id: app.id, type: "apps" } } }, type: "betaGroups" } }
      Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaGroups", body)
      group = app.get_beta_groups.find(&:is_internal_group)
      UI.success("Created internal group '#{group.name}' (#{group.id})")
    else
      UI.message("Using internal group '#{group.name}' (#{group.id})")
    end
    Spaceship::ConnectAPI.client.post_beta_tester_assignment(
      beta_group_ids: [group.id],
      attributes: { email: email, firstName: "Gary", lastName: "Hsieh" },
    )
    UI.success("Added internal tester #{email} to '#{group.name}'")
  end
end
